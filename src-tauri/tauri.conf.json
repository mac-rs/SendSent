{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sendsent",
  "version": "0.1.0",
  "identifier": "com.mankong.sendsent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SendSent",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 560,
        "backgroundColor": "#f6f6f8",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "gen/apple/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
