<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed (direct distribution, not Mac App Store): the App Sandbox
	     blocked raw multicast (mdns-sd) and redirected $HOME, so discovery and
	     the default save dir broke in release builds while dev (unsandboxed) worked. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
